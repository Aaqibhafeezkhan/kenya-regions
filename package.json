{
  "name": "kenya-regions",
  "version": "2.2.0",
  "description": "Offline dataset and typed API for every way Kenya is divided: 47 counties, 290 constituencies, 1450 wards, the 8 former provinces, ISO 3166-2 codes, OCHA p-codes, regional economic blocs and the ASAL classification. No network, no dependencies.",
  "keywords": [
    "kenya",
    "counties",
    "constituencies",
    "wards",
    "sub-counties",
    "provinces",
    "regions",
    "iebc",
    "knbs",
    "iso-3166-2",
    "pcodes",
    "administrative-divisions",
    "east-africa",
    "geodata",
    "dropdown",
    "districts",
    "divisions",
    "locations",
    "sub-locations",
    "census",
    "provincial-administration",
    "geojson",
    "outlines",
    "map",
    "point-in-polygon"
  ],
  "license": "MIT",
  "author": "Nicanor Korir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicanor-korir/kenya-regions.git"
  },
  "bugs": {
    "url": "https://github.com/nicanor-korir/kenya-regions/issues"
  },
  "homepage": "https://github.com/nicanor-korir/kenya-regions#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./counties": {
      "import": {
        "types": "./dist/counties.d.ts",
        "default": "./dist/counties.js"
      },
      "require": {
        "types": "./dist/counties.d.cts",
        "default": "./dist/counties.cjs"
      }
    },
    "./constituencies": {
      "import": {
        "types": "./dist/constituencies.d.ts",
        "default": "./dist/constituencies.js"
      },
      "require": {
        "types": "./dist/constituencies.d.cts",
        "default": "./dist/constituencies.cjs"
      }
    },
    "./wards": {
      "import": {
        "types": "./dist/wards.d.ts",
        "default": "./dist/wards.js"
      },
      "require": {
        "types": "./dist/wards.d.cts",
        "default": "./dist/wards.cjs"
      }
    },
    "./subcounties": {
      "import": {
        "types": "./dist/subcounties.d.ts",
        "default": "./dist/subcounties.js"
      },
      "require": {
        "types": "./dist/subcounties.d.cts",
        "default": "./dist/subcounties.cjs"
      }
    },
    "./districts": {
      "import": {
        "types": "./dist/districts.d.ts",
        "default": "./dist/districts.js"
      },
      "require": {
        "types": "./dist/districts.d.cts",
        "default": "./dist/districts.cjs"
      }
    },
    "./divisions": {
      "import": {
        "types": "./dist/divisions.d.ts",
        "default": "./dist/divisions.js"
      },
      "require": {
        "types": "./dist/divisions.d.cts",
        "default": "./dist/divisions.cjs"
      }
    },
    "./locations": {
      "import": {
        "types": "./dist/locations.d.ts",
        "default": "./dist/locations.js"
      },
      "require": {
        "types": "./dist/locations.d.cts",
        "default": "./dist/locations.cjs"
      }
    },
    "./sublocations": {
      "import": {
        "types": "./dist/sublocations.d.ts",
        "default": "./dist/sublocations.js"
      },
      "require": {
        "types": "./dist/sublocations.d.cts",
        "default": "./dist/sublocations.cjs"
      }
    },
    "./provinces": {
      "import": {
        "types": "./dist/provinces.d.ts",
        "default": "./dist/provinces.js"
      },
      "require": {
        "types": "./dist/provinces.d.cts",
        "default": "./dist/provinces.cjs"
      }
    },
    "./blocs": {
      "import": {
        "types": "./dist/blocs.d.ts",
        "default": "./dist/blocs.js"
      },
      "require": {
        "types": "./dist/blocs.d.cts",
        "default": "./dist/blocs.cjs"
      }
    },
    "./country": {
      "import": {
        "types": "./dist/country.d.ts",
        "default": "./dist/country.js"
      },
      "require": {
        "types": "./dist/country.d.cts",
        "default": "./dist/country.cjs"
      }
    },
    "./outlines": {
      "import": {
        "types": "./dist/outlines.d.ts",
        "default": "./dist/outlines.js"
      },
      "require": {
        "types": "./dist/outlines.d.cts",
        "default": "./dist/outlines.cjs"
      }
    },
    "./data/*.json": "./data/*.json",
    "./data/csv/*.csv": "./data/csv/*.csv",
    "./data/svg/*": "./data/svg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data/*.json",
    "data/csv/*.csv",
    "data/svg/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build": "npm run build:data && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "prettier --check \"{src,scripts,test}/**/*.{ts,mjs}\"",
    "format": "prettier --write \"{src,scripts,test}/**/*.{ts,mjs}\"",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "test:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
